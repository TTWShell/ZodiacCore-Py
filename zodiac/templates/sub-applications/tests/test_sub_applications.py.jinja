import importlib

from fastapi.testclient import TestClient


def test_users_and_orders_share_parent_resources(monkeypatch):
    monkeypatch.setenv("APPLICATION_ENVIRONMENT", "testing")
    main = importlib.import_module("main")

    with TestClient(main.create_app()) as client:
        health_response = client.get("/api/health")
        users_health_response = client.get("/users/api/v1/health")
        orders_health_response = client.get("/orders/api/v1/health")
        user_response = client.post(
            "/users/api/v1/users",
            json={"name": "Ada Lovelace", "email": "ada@example.com"},
        )
        order_response = client.post(
            "/orders/api/v1/orders",
            json={"user_id": 1, "item": "Notebook", "quantity": 2},
        )

        users_response = client.get("/users/api/v1/users")
        orders_response = client.get("/orders/api/v1/orders")
        users_info = client.get("/users/api/v1/info")
        orders_info = client.get("/orders/api/v1/info")

    assert health_response.status_code == 200
    assert health_response.json() == {"status": "healthy", "service": "{{ project_name }}"}
    assert users_health_response.status_code == 404
    assert orders_health_response.status_code == 404
    assert user_response.status_code == 201
    assert user_response.json()["email"] == "ada@example.com"
    assert order_response.status_code == 201
    assert order_response.json()["item"] == "Notebook"
    assert users_response.json() == [
        {"id": 1, "name": "Ada Lovelace", "email": "ada@example.com"},
    ]
    assert orders_response.json() == [
        {"id": 1, "user_id": 1, "item": "Notebook", "quantity": 2},
    ]
    assert users_info.json() == {"service": "users", "cache": "shared"}
    assert orders_info.json() == {"service": "orders", "cache": "shared"}

    assert len(health_response.headers.get_list("x-request-id")) == 1
    assert len(user_response.headers.get_list("x-request-id")) == 1
    assert len(order_response.headers.get_list("x-request-id")) == 1
