"""Health check endpoint tests for the multi-app server."""


class TestHealthEndpoint:
    async def test_health_endpoint_sets_request_id_header(self, client):
        """Health endpoint should include the standard request ID header."""
        response = await client.get("/api/health")

        assert response.status_code == 200
        assert "X-Request-ID" in response.headers
        assert len(response.headers["X-Request-ID"]) == 36
        assert response.json() == {
            "code": 0,
            "message": "Success",
            "data": {
                "status": "healthy",
                "service": "{{ project_name }}",
            },
        }

    async def test_request_id_not_duplicated_on_sub_app_routes(self, client):
        """Sub-app routes should have exactly one X-Request-ID header."""
        response = await client.get("/users/api/v1/users?page=1&size=20")

        assert len(response.headers.get_list("x-request-id")) == 1
