from fastapi import FastAPI
from zodiac_core.exception_handlers import register_exception_handlers
from zodiac_core.middleware import register_middleware

from {{ package_name }}.orders.api.router import router
from {{ package_name }}.orders.core.container import Container


def create_orders_app() -> FastAPI:
    app = FastAPI(title="orders-service")

    register_middleware(app, service_name="orders")
    register_exception_handlers(app)

    container = Container()
    container.wire(modules=["{{ package_name }}.orders.api.routers.order_router"])
    app.state.container = container

    app.include_router(router)
    return app
