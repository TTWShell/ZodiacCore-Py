from zodiac_core.routing import APIRouter

from {{ package_name }}.orders.api.routers.order_router import router as order_router

router = APIRouter(prefix="/api/v1")

router.include_router(order_router, prefix="/orders", tags=["Orders"])


@router.get("/info")
async def service_info():
    """Service metadata endpoint."""
    from {{ package_name }}.orders.application.services.order_service import OrderService

    svc = OrderService()
    return await svc.service_info()
