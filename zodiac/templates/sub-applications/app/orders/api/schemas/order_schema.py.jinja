from pydantic import Field
from zodiac_core.pagination import PageSortParams
from zodiac_core.schemas import CoreModel, IntIDSchema


class OrderListParams(PageSortParams):
    keyword: str | None = Field(None, min_length=1, description="Search by item name.")


class OrderCreate(CoreModel):
    user_id: int = Field(gt=0)
    item: str = Field(min_length=1)
    quantity: int = Field(default=1, ge=1)


class OrderRead(IntIDSchema):
    user_id: int
    item: str
    quantity: int
