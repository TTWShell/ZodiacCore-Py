from zodiac_core.cache import cached
from zodiac_core.pagination import PagedResponse, PageSortParams

from {{ package_name }}.users.api.schemas.user_schema import UserCreate
from {{ package_name }}.users.infrastructure.database.models.user_model import UserModel
from {{ package_name }}.users.infrastructure.database.repositories.user_repository import UserRepository


class UserService:
    def __init__(self, repository: UserRepository) -> None:
        self.repository = repository

    async def create_user(self, payload: UserCreate) -> UserModel:
        return await self.repository.create(UserModel(name=payload.name, email=str(payload.email)))

    async def list_users(self, params: PageSortParams, keyword: str | None = None) -> PagedResponse[UserModel]:
        return await self.repository.list(params, keyword=keyword)

    @cached(ttl=30, include_self=True)
    async def service_info(self) -> dict[str, str]:
        return {"service": "users", "cache": "shared"}
