"""Contract tests for the {{ service_name }} sub-application.

These tests expect the generated sub-application to be wired into main.py.
"""


class TestResourceApi:
    resource_url = (
        "/{{ service_name }}"
        "/api/v1/"
        "{{ resource_plural }}"
    )

    async def test_create_resource(self, client):
        response = await client.post(
            self.resource_url,
            json={"name": "Example {{ resource_class }}"},
        )

        assert response.status_code == 201
        body = response.json()
        assert body["code"] == 0
        assert body["data"]["name"] == "Example {{ resource_class }}"
        assert "id" in body["data"]

    async def test_list_resources_uses_standard_paged_response(self, client):
        response = await client.get(
            f"{self.resource_url}?page=1&size=20",
        )

        assert response.status_code == 200
        body = response.json()
        assert body["code"] == 0
        assert body["data"]["items"] == []
        assert body["data"]["total"] == 0
        assert body["data"]["page"] == 1
        assert body["data"]["size"] == 20

    async def test_list_resources_supports_keyword_and_sort(self, client):
        await client.post(self.resource_url, json={"name": "Alpha"})
        await client.post(self.resource_url, json={"name": "Beta"})
        await client.post(self.resource_url, json={"name": "Gamma"})

        response = await client.get(
            f"{self.resource_url}?keyword=a&sort=name:desc&page=1&size=20",
        )

        assert response.status_code == 200
        body = response.json()
        assert body["code"] == 0
        assert body["data"]["total"] == 3
        assert [item["name"] for item in body["data"]["items"]] == ["Gamma", "Beta", "Alpha"]

    async def test_list_resources_rejects_unsupported_sort_field(self, client):
        response = await client.get(
            f"{self.resource_url}?sort=unknown:asc",
        )

        assert response.status_code == 400
        body = response.json()
        assert body["message"] == "Unsupported sort field 'unknown'. Supported sort fields: id, name."
        assert body["data"] == {
            "field": "unknown",
            "supported_fields": ["id", "name"],
        }
